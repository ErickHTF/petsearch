# Copy to .env and fill in. Never commit .env (PRV-05).
NODE_ENV=development
PORT=3000
# PostgreSQL from `docker compose up -d db`
DATABASE_URL=postgres://petsearch:petsearch@localhost:5432/petsearch
# Used by `npm test` (database created by docker/initdb)
TEST_DATABASE_URL=postgres://petsearch:petsearch@localhost:5432/petsearch_test
# Long random string, e.g. `openssl rand -hex 32`
SESSION_SECRET=change-me
# Defaults to true in production; set false only for local HTTP
COOKIE_SECURE=
