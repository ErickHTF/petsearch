# Copy to .env and fill in. Never commit .env (PRV-05).
NODE_ENV=development
PORT=3000
# Local MongoDB from docker compose
MONGODB_URI=mongodb://localhost:27017/petsearch
# Long random string, e.g. `openssl rand -hex 32`
SESSION_SECRET=change-me
# Comma-separated emails that get the moderator role on sign up
MODERATOR_EMAILS=
