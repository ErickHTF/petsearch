{
  "name": "petsearch",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev:api": "npm run dev -w @petsearch/api",
    "dev:web": "npm run dev -w @petsearch/web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && npm run test:scripts",
    "build": "npm run build -w @petsearch/web && npm run build -w @petsearch/api",
    "start": "node apps/api/dist/server.js",
    "seed": "npm run seed -w @petsearch/api",
    "e2e": "playwright test",
    "check:trace": "node scripts/check-traceability.mjs",
    "test:scripts": "node --test scripts/"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "argon2@0.44.0": true,
    "sharp@0.34.5": true,
    "esbuild@0.18.20": true
  }
}
